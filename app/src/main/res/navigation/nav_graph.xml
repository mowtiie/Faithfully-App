<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/chaptersFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.ChaptersFragment"
        android:label="@string/title_chapters">
        <action
            android:id="@+id/action_chapters_to_cards"
            app:destination="@id/cardsFragment" />
    </fragment>

    <fragment
        android:id="@+id/cardsFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.CardsFragment"
        android:label="{chapter_title}">
        <argument
            android:name="chapter_id"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="chapter_title"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.GalleryFragment"
        android:label="@string/title_gallery" />

    <fragment
        android:id="@+id/voiceFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.VoiceFragment"
        android:label="@string/title_voice" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.SettingsFragment"
        android:label="@string/title_settings" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.mowtiie.faithfully.ui.fragments.AboutFragment"
        android:label="@string/title_about" />
</navigation>
