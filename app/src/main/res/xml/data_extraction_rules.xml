<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The chapter cache holds private content; keep it out of cloud backup and device transfer. -->
    <cloud-backup>
        <exclude domain="database" path="faithfully.db" />
        <exclude domain="database" path="faithfully.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="faithfully.db" />
        <exclude domain="database" path="faithfully.db-journal" />
    </device-transfer>
</data-extraction-rules>
